# Agent Router Configuration
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_TEXT_MODEL=gpt-5.6-sol
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Optional: Puter.js Auth Token for free AI image generation (from puter.com)
PUTER_AUTH_TOKEN=

# OpenRouter Free TTS Narration
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free

# Sarvam AI TTS (server-side only; rotate exposed keys before use)
SARVAM_API_KEY=
DOCUMENTARY_TTS_PROVIDER=neural
DOCUMENTARY_TTS_MODEL=edge-neural
DOCUMENTARY_TTS_VOICE=hi-IN-MadhurNeural
KIDS_TTS_PROVIDER=neural
KIDS_TTS_MODEL=edge-neural
KIDS_TTS_VOICE=hi-IN-SwaraNeural

# Storage directory
DATA_DIR=data
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional administrator bootstrap values for migration scripts
ADMIN_EMAIL=
ADMIN_PASSWORD=
MIGRATION_DEFAULT_PASSWORD=

# Supabase database and authentication
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment gateways
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
